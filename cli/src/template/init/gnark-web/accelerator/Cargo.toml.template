[package]
name = "mopro-gnark-accelerator"
version = "0.1.0"
edition = "2021"
license = "Apache-2.0"
description = "Threaded browser arithmetic for gnark Groth16 BN254"

[lib]
crate-type = ["cdylib", "rlib"]

[features]
default = []
mcl-msm = ["dep:mcl_rust"]
msm-check = []

[dependencies]
mcl_rust = { git = "https://github.com/herumi/mcl-rust", rev = "81981d036f736ab96800987e1678d7ca15182f76", optional = true }
ark-bn254 = "0.5"
ark-ec = { version = "0.5", features = ["parallel"] }
ark-ff = { version = "0.5", features = ["parallel"] }
ark-poly = { version = "0.5", features = ["parallel"] }
rayon = "1.10"
wasm-bindgen = "=0.2.128"
wasm-bindgen-rayon = { version = "1.3", features = ["no-bundler"] }

[profile.release]
opt-level = 3
lto = true
codegen-units = 1

[package.metadata.wasm-pack.profile.release]
wasm-opt = false

[workspace]
members = []
